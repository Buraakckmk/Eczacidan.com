# Backend Ortam Değişkenleri
# Kullanmak için bu dosyayı .env olarak kopyalayın ve değerleri güncelleyin.

# Proje
PROJECT_NAME=Eczacıdan.com B2B Platform
API_V1_PREFIX=/api/v1

# Veritabanı - PostgreSQL (Önerilen)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eczacidan_db
# PostgreSQL yoksa SQLite kullanmak için üst satırı yorumlayıp bunu açın:
# DATABASE_URL=sqlite:///./eczacidan.db

# CORS (virgül ile ayrılmış)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006,http://localhost:3000

# JWT Güvenliği (üretim ortamında güçlü ve benzersiz bir secret kullanın!)
JWT_SECRET_KEY=super-secret-dev-key-change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
